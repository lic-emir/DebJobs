<main class="contenedor">
  <form action="/iniciar-sesion" method="POST" class="default-form">
    <div class="campo">
      <label for="email">E-mail</label>
      <input type="email" name="email" id="email" placeholder="Tu Email" required>
    </div>
    <div class="campo">
      <label for="password">E-mail</label>
      <input type="password" name="password" id="password" placeholder="Tu Password" required>
    </div>
    <div class="campo">
      <a href="/crear-cuenta">Crear una Cuenta</a>
      <a href="/reestablecer-password" style="margin-left: 15px;">Olvidé mi Password</a>
    </div>
    <div class="campo">
      <input type="submit" value="Iniciar Sesión" class="btn btn-azul">
    </div>
  </form>
</main>