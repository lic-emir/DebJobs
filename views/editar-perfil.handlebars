<main class="contenedor">
  <form action="/editar-perfil" method="POST" class="default-form">
    <div class="campo">
      <label for="nombre">Nombre</label>
      <input value="{{usuario.nombre}}" type="text" name="nombre" id="nombre" placeholder="Tu nombre" required>
    </div>
    <div class="campo">
      <label for="email">E-mail</label>
      <input value="{{usuario.email}}" type="email" name="email" id="email" placeholder="Tu E-mail" required>
    </div>
    <div class="campo">
      <label for="password">Password Viejo</label>
      <input type="password" name="password" id="password" placeholder="Tu password">
    </div>
    <div class="campo">
      <label for="nuevo-password">Password Nuevo</label>
      <input type="password" name="nuevo-password" id="nuevo-password" placeholder="Tu password">
    </div>
    <div class="campo">
      <input type="submit" class="btn btn-azul" value="Guardar Cambios">
    </div>
  </form>
</main>